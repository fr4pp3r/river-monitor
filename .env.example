# River Monitor System Environment Configuration
# Copy to .env and adjust values for your deployment

# ======================================
# Application Settings
# ======================================
APP_NAME=River Monitor
APP_ENV=development
APP_DEBUG=false
TIMEZONE=Asia/Manila

# ======================================
# Database Configuration
# ======================================
DATABASE_PATH=data/river_monitor.db

# ======================================
# Dashboard Configuration
# ======================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
AUTO_REFRESH_SECONDS=30

# ======================================
# Authentication
# ======================================
AUTH_ENABLED=true
SECRET_KEY=change-me-in-production-river-monitor
SESSION_MAX_AGE_SECONDS=43200
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ======================================
# Hardware Enable/Disable
# ======================================
LORA_ENABLED=true
SMS_ENABLED=false

# ======================================
# LoRa Configuration (RFM95W)
# ======================================
LORA_SPI_PORT=0
LORA_CE_PIN=5
LORA_CS_PIN=8
LORA_RESET_PIN=22
LORA_FREQUENCY=915.0
LORA_BANDWIDTH=125
LORA_SPREADING_FACTOR=7
LORA_CODING_RATE=5

# ======================================
# SMS Configuration (A7608e-H)
# ======================================
SMS_UART_PORT=/dev/ttyUSB2
SMS_BAUD_RATE=115200
SMS_TIMEOUT=5

# ======================================
# Alert Configuration
# ======================================
ALERT_PHONE_NUMBERS=+639940176150
SMS_ALERT_RISK_LEVELS=alarm,critical
SMS_ALERT_COOLDOWN_MINUTES=30

# ======================================
# Weather API Configuration
# ======================================
WEATHER_LATITUDE=9.299495315028961
WEATHER_LONGITUDE=118.43788786664786
WEATHER_FORECAST_DAYS=7
WEATHER_CACHE_EXPIRY=21600
WEATHER_TIMEZONE=auto

# ======================================
# Risk & Threshold Configuration
# ======================================
CRITICAL_LEVEL_M=2.0
RECEDING_HOURS=2
RAIN_DAY_THRESHOLD_MM=2.0

# Thresholds
WL_LOW_MAX=610
WL_MEDIUM_MIN=610
WL_MEDIUM_MAX=1220
WL_HIGH_MIN=1220
WL_HIGH_MAX=1830
WL_VERY_HIGH_MIN=1830

FRAIN_NONE_MAX=5
FRAIN_LIGHT_MIN=5
FRAIN_LIGHT_MAX=15
FRAIN_MODERATE_MIN=15
FRAIN_MODERATE_MAX=30
FRAIN_HEAVY_MIN=30

ROR_NEGATIVE_MAX=-0.5
ROR_NEAR_ZERO_MIN=-0.5
ROR_NEAR_ZERO_MAX=0.5
ROR_MODERATE_MIN=0.5
ROR_MODERATE_MAX=4.0
ROR_RAPID_MIN=4.0

TIDE_LOW_MAX=0.5
TIDE_MID_MIN=0.5
TIDE_MID_MAX=1.0
TIDE_HIGH_MIN=1.0
TIDE_HIGH_MAX=1.5
TIDE_EXTREME_MIN=1.5
